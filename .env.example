# Application
APP_NAME=Financial Automation Platform
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server (local development)
HOST=0.0.0.0
PORT=8000

# Database (SQLite default; Heroku sets DATABASE_URL automatically)
DATABASE_URL=sqlite:///./data/financial_data.db
# DATABASE_URL=postgresql://user:password@localhost:5432/financial_automation

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=app.log

# OpenAPI / docs (set false in production if needed)
OPENAPI_ENABLED=true

# External APIs
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/BGN

# Scraping (Task 3) — optional browser fallback for Cloudflare-protected sites
# Requires: pip install playwright && playwright install chromium
SCRAPING_BROWSER_FALLBACK=false
# SCRAPING_USE_CURL_IMPERSONATE=false
# SCRAPING_PLAYWRIGHT_HEADED=false

# LLM extraction (Task 4) — optional; deterministic mock rules used when unset
# OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
